# Pi behind Tailscale Funnel: plain http on loopback only; Funnel terminates TLS.
{
	auto_https off
	# The container healthcheck polls the admin API every 30s; keep those requests out of the log.
	log {
		exclude admin.api
	}
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		# Funnel connects from the host, which Caddy sees as the edge network's gateway. Trust
		# exactly that one address (not the whole private range: other containers can reach this
		# port too). "strict" takes the RIGHTMOST untrusted X-Forwarded-For entry, which is what the
		# last trusted hop appended; entries to its left are client-controlled.
		trusted_proxies static {$EDGE_GATEWAY}/32
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

import /etc/caddy/common.caddy

:8080 {
	import site
}
