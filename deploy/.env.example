# Copy to ".env" next to compose.prod.yaml and fill in. Never commit the real file.

# Public hostname Caddy gets a Let's Encrypt certificate for (DNS must point at this host).
# Use "localhost" for a local test (Caddy issues an internal, untrusted certificate).
DOMAIN=tracker.example.com

# Exact public origin, no trailing slash. Used for OAuth redirects and cookie scope.
PUBLIC_ORIGIN=https://tracker.example.com

# Postgres. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Must use the same password as above (host "db" is the compose service).
DATABASE_URL=postgresql+psycopg://tracker:change-me@db:5432/tracker

# Discord application (see docs/DEPLOY.md).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Send session cookies over HTTPS only.
COOKIE_SECURE=1

# Optional: image tag to run (pin a version so rollback is a one-line change).
# APP_IMAGE=wardogs-patch-tracker:latest
# Optional: published ports (change only for local tests).
# HTTP_PORT=80
# HTTPS_PORT=443
