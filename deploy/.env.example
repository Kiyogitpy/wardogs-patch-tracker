# Copy to ".env" next to compose.prod.yaml and fill in. Never commit the real file.

# Public hostname Caddy gets a Let's Encrypt certificate for (DNS must point at this host).
# Use "localhost" for a local test (Caddy issues an internal, untrusted certificate).
# Not used by compose.pi.yaml (Tailscale Funnel).
DOMAIN=tracker.example.com

# Exact public origin, no trailing slash. Must be https. Used for OAuth redirects and cookie scope.
# Raspberry Pi with Funnel: https://<host>.<tailnet>.ts.net
PUBLIC_ORIGIN=https://tracker.example.com

# Postgres owner role "tracker": used only by the one-shot `migrate` service (never by the app).
# Generate passwords with: openssl rand -hex 24   (hex avoids URL and compose-interpolation escapes)
POSTGRES_PASSWORD=change-me
MIGRATE_DATABASE_URL=postgresql+psycopg://tracker:change-me@db:5432/tracker
# Restricted role "tracker_app" (DML only), created by `migrate` with the password given here.
# Use a different password from the owner's. The app refuses to start while "change-me" is in either URL.
DATABASE_URL=postgresql+psycopg://tracker_app:change-me@db:5432/tracker

# Discord application (see docs/DEPLOY.md).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Send session cookies over HTTPS only.
COOKIE_SECURE=1

# Optional: image tag to run (pin a version so rollback is a one-line change).
# APP_IMAGE=wardogs-patch-tracker:latest
# Optional: published ports (change only for local tests; PI_PORT is for compose.pi.yaml).
# HTTP_PORT=80
# HTTPS_PORT=443
# PI_PORT=8080
# Optional: the fixed `edge` network (Caddy + app). Defaults differ per file so both stacks can share a host:
#   compose.prod.yaml: 172.29.57.0/24, gateway .1, Caddy .254   compose.pi.yaml: 172.29.58.0/24, gateway .1, Caddy .254
# Set all three together, and only if the default clashes with your network. CADDY_IP must be inside EDGE_SUBNET,
# near the top (Docker hands out other addresses from the bottom). Do not put them in one shared .env for both stacks.
# EDGE_SUBNET=172.29.57.0/24
# EDGE_GATEWAY=172.29.57.1
# CADDY_IP=172.29.57.254
