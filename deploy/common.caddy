# Shared by Caddyfile (public TLS) and Caddyfile.pi (Tailscale Funnel).

# Security headers on every response Caddy writes: static files, proxied responses, the 413 from
# request_body, redirects, the unknown-Host answer and handle_errors. "?" sets a header only when
# the app did not already; defer applies it after the handler (and after errors) have run.
(headers) {
	header {
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?Cross-Origin-Opener-Policy "same-origin"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
		-Server
		-Via
		defer
	}
}

(html_headers) {
	Cache-Control "no-cache"
	Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.discordapp.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
	Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
}

(site) {
	import headers
	encode zstd gzip

	# The web app needs no request bodies and the API takes small JSON, so cap every path.
	request_body {
		max_size 64KB
	}

	# Only the exact lower-case /api prefix reaches Python (path_regexp is case-sensitive, unlike `path`,
	# which would also match /API/x and send it to the app's static fallback with no rate limit). Other
	# case variants fall through to the static SPA fallback below. Same rule as _is_api in server.py.
	# Only /api reaches Python. Everything else is served from the copy of web/dist baked into
	# the Caddy image (/srv), so a static-file flood never queues behind the app.
	@api path_regexp ^/api(/|$)
	handle @api {
		reverse_proxy app:8000 {
			# One address only: the client as Caddy sees it (see Caddyfile.pi for the trusted hop).
			header_up X-Forwarded-For {client_ip}
			header_down -Via
		}
	}

	handle /assets/* {
		# Hashed file names: cache for a year. A missing asset is a plain 404, never index.html.
		# Not on a trailing-slash request: for a file, file_server answers that with a 308 redirect, which must
		# not be cached for a year.
		@hashed not path */
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	handle {
		@write not method GET HEAD
		header @write Allow "GET, HEAD"
		respond @write "Method Not Allowed" 405

		root * /srv
		# Real files other than index.html (favicon...): short cache. Everything else is the SPA shell.
		@real {
			file {path}
			not path /index.html
		}
		header @real Cache-Control "public, max-age=3600"
		@shell not file {path}
		header @shell {
			import html_headers
		}
		@index path /index.html
		header @index {
			import html_headers
		}
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		import headers
		# An error from a long-cache route (missing /assets file) must not be cached with it.
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
